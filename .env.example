# Server-only — never prefix with NEXT_PUBLIC_, the browser never calls the
# Ticker API directly (portfolio.md §8, Option B: Next.js is the sole
# public ingress, proxying reads/SSE over the Docker network).
#
# Local dev: `ticker`'s `make run`/`make dev` run natively in this same
# devcontainer (not a sibling container), so `localhost` reaches it
# directly — no host.docker.internal workaround needed here (that's only
# for the docker-compose-managed Redis/Timescale containers).
#
# Production: infra/docker-compose.yml sets this to http://ticker:8080
# (the compose service name, on the shared Docker network).
TICKER_API_URL=http://localhost:8080

# Public/build-time — canonical URLs, OG images and sitemap/robots, all read
# through the single SITE_URL constant in lib/site.ts (portfolio.md §5, §13).
# Production value is https://akjames.dev.
#
# Like NEXT_PUBLIC_SENTRY_DSN below, `next build` inlines this, so it has to
# reach the *build* step — infra/docker-compose.yml sets it as a runtime
# container env var too, but that copy lands after everything that reads it has
# already been compiled. The value that actually matters is the --build-arg in
# .github/workflows/ci.yml, sourced from a plain (non-secret) repo variable
# with a literal fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public/build-time, not a secret — a DSN only lets you submit events, not
# read Sentry data (portfolio.md §13). Baked into the client bundle by
# `next build`, so — unlike every other env var here — it has to reach the
# *build* step, not just the running container: production value comes from
# a --build-arg in .github/workflows/ci.yml (portfolio's own CI, not
# infra/deploy.yml), sourced from a plain (non-secret) repo variable.
# Blank/omitted locally is fine — Sentry.init() no-ops without a DSN.
NEXT_PUBLIC_SENTRY_DSN=
